# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.Python
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Secrets / environment config ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.json

# --- Caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.cache

# --- Logs ---
*.log
logs/

# --- Corpus data (raw/normalized) — not committed by default ---
data/raw/
data/normalized/
data/chunks/
data/indexes/

# --- Model caches / artifacts ---
models/
*.bin
*.gguf
*.safetensors
.huggingface/

# --- Generated indexes / vector stores ---
*.faiss
*.index
chroma/

# --- Databases (local dev) ---
*.sqlite3
*.db

# --- Node / frontend (future phases) ---
node_modules/
frontend/dist/
frontend/build/

# --- Release artifacts (Phase 22 Step 22.4, generated - never committed) ---
# scripts/build_release_manifest.py's own output; CI uploads it as a
# GitHub-native build artifact instead (actions/upload-artifact).
/release_manifest.json

# --- OS / editor files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Notes ---
# data/manifest/ (source registry, checksums, provenance) is intentionally
# NOT ignored — it must be version controlled per Phase 2 (Authority Matrix
# & Corpus Lock). Do not add a blanket ignore for data/ or config/.
